# YPTT TI Tracker — Self-hosted backend environment configuration
# Values MUST be supplied via environment / secret store. DO NOT commit real secrets.

# Firebase project (matches the frontend Firebase config)
FIREBASE_PROJECT_ID=yptt-ti

# --- Firebase Admin credential strategy ---
# Local dev: set GOOGLE_APPLICATION_CREDENTIALS=<path-to-service-account.json>
#   OR FIREBASE_SERVICE_ACCOUNT=<base64 of service account JSON>
# Production: set GOOGLE_APPLICATION_CREDENTIALS via the hosting platform secret store.
# The backend does NOT require the project Blaze plan (it is a plain Node.js server).

# Deployed Apps Script web-app URL (the same backend this gateway proxies to)
APP_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Strong random secret. MUST be byte-for-byte identical to the Apps Script
# Script Property "TICKET_SIGNING_SECRET". Generate, e.g.:
#   openssl rand -base64 48
TICKET_SIGNING_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# Ticket identity realm (must match Apps Script Script Properties)
TICKET_ISSUER=yptt-ti-tracker-gateway
TICKET_AUDIENCE=yptt-ti-tracker-appsscript

# Short ticket lifetime in seconds (60-120 recommended)
TICKET_TTL_SECONDS=120

# Optional comma-separated admin UIDs (RBAC) - or set admin custom claims in Firebase
ADMIN_UIDS=

# HTTP port the self-hosted server listens on
PORT=8080

# Comma-separated list of allowed CORS origins (frontend). "*" allows all.
CORS_ORIGINS=*
